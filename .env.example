# Split Learning Privacy Agent — Environment Configuration
# Copy this file to .env and fill in secure values.
# NEVER commit .env to version control.

# HMAC-SHA256 Audit Trail Secret Key
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-secure-random-key-here

# LLM Provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock

# Optional separate token to permit GET /api/audit/logs.
# Keep secret; do not use the HMAC signing key as the read token.
# AUDIT_LOG_READ_TOKEN=generate-an-independent-random-token
